{
  "name": "ClubSeason",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "finalized": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "start_at",
    "end_at"
  ]
}