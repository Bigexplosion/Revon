{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "banner_image": {
      "type": "string"
    },
    "track_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "track_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "entry_cost": {
      "type": "integer",
      "default": 0
    },
    "reward_pool": {
      "type": "integer",
      "default": 0
    },
    "placement_rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "place": {
            "type": "integer"
          },
          "points": {
            "type": "integer"
          },
          "badge": {
            "type": "string"
          }
        }
      }
    },
    "participant_count": {
      "type": "integer",
      "default": 0
    },
    "rules": {
      "type": "string"
    },
    "finalized": {
      "type": "boolean",
      "default": false
    },
    "winner_nickname": {
      "type": "string"
    },
    "region": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "start_at",
    "end_at"
  ]
}